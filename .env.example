DEEPSEEK_API_KEY=your_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

DASHSCOPE_API_KEY=your_server_only_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# RAG 向量化（默认硅基流动免费 BAAI/bge-m3；可设为 dashscope 使用百炼 text-embedding-v4）
RAG_EMBEDDING_PROVIDER=siliconflow
SILICONFLOW_API_KEY=your_server_only_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# RAG 重排序（默认跟随 RAG_EMBEDDING_PROVIDER：硅基流动 BAAI/bge-reranker-v2-m3 / 百炼 qwen3-rerank）
# RAG_RERANK_PROVIDER=siliconflow
# 百炼 rerank 走 compatible-api 路径；如需工作空间专属地址可在此覆盖
# DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
# RAG 查询改写（硅基流动免费对话模型，复用 SILICONFLOW_API_KEY；失败时只用原问题检索）
# RAG_REWRITE_MODEL=THUDM/GLM-4-9B-0414
