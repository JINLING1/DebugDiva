# Local Vite proxy and production server-side variables.
# Never expose the API key through application source code.
DEEPSEEK_API_KEY=your_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional. Defaults to the same-origin Pages Function endpoint.
VITE_CHAT_API_URL=/api/chat
