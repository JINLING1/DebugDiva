# Local Vite proxy and production server-side variables.
# Never expose the API key through application source code.
DEEPSEEK_API_KEY=your_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional for image analysis through the Vite development proxy. Production
# uses the Cloudflare Pages Workers AI binding configured as `AI`.
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
VISION_MODEL=@cf/moondream/moondream3.1-9B-A2B
